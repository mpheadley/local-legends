<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SL Shirt Mockup Review</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: #111;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #f0ede8;
    padding: 32px;
  }
  h1 {
    font-size: 13px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #ca8a04;
    margin-bottom: 6px;
  }
  .subtitle {
    font-size: 11px;
    color: rgba(255,255,255,0.3);
    margin-bottom: 20px;
  }
  .legend {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    font-size: 11px;
    color: rgba(255,255,255,0.4);
  }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot.composite { background: #4ade80; }
  .dot.raw { background: #f97316; }
  .dot.missing { background: #6b7280; }

  /* ── Section dividers ── */
  .section-label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(202,138,4,0.6);
    margin: 36px 0 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  /* ── Grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 16px;
  }

  /* ── Card ── */
  .card {
    background: #1c1917;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    overflow: hidden;
  }

  /* ── Dual image row ── */
  .img-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .img-panel {
    position: relative;
    aspect-ratio: 1;
    background: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .img-panel:first-child {
    border-right: 1px solid rgba(255,255,255,0.05);
  }
  .img-panel img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
    display: block;
  }
  .img-panel .panel-label {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 99px;
  }
  .panel-label.raw-label { background: rgba(249,115,22,0.18); color: #f97316; border: 1px solid rgba(249,115,22,0.25); }
  .panel-label.composite-label { background: rgba(74,222,128,0.15); color: #4ade80; border: 1px solid rgba(74,222,128,0.2); }
  .panel-label.missing-label { background: rgba(107,114,128,0.18); color: #9ca3af; border: 1px solid rgba(107,114,128,0.2); }

  .img-panel .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255,255,255,0.15);
    font-size: 10px;
    text-align: center;
    padding: 12px;
    height: 100%;
  }
  .img-panel .placeholder svg {
    opacity: 0.2;
  }

  /* ── Card body ── */
  .card-body {
    padding: 10px 12px 12px;
  }
  .card-name {
    font-size: 13px;
    font-weight: 700;
    color: #f0ede8;
    margin-bottom: 3px;
    line-height: 1.3;
  }
  .card-id {
    font-size: 10px;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
    margin-bottom: 4px;
  }
  .card-paths {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
  }
  .card-path {
    font-size: 9px;
    font-family: monospace;
    word-break: break-all;
    line-height: 1.4;
    color: rgba(255,255,255,0.2);
  }
  .card-path.has-mockup { color: rgba(74,222,128,0.5); }
  .card-path.needs-mockup { color: rgba(249,115,22,0.5); }
  .card-path.corrupted { color: rgba(239,68,68,0.5); }

  .badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
    margin-top: 6px;
    margin-right: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .badge.composite { background: rgba(74,222,128,0.12); color: #4ade80; border: 1px solid rgba(74,222,128,0.2); }
  .badge.raw { background: rgba(249,115,22,0.12); color: #f97316; border: 1px solid rgba(249,115,22,0.2); }
  .badge.missing { background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
  .badge.note { background: rgba(107,114,128,0.12); color: #9ca3af; border: 1px solid rgba(107,114,128,0.2); }

  /* ── Ecclesia section ── */
  .ecclesia-note {
    font-size: 10px;
    color: rgba(255,255,255,0.3);
    margin-top: 4px;
  }
</style>
</head>
<body>

<h1>Southern Legends + Ecclesia — Shirt Mockup Review</h1>
<p class="subtitle">Each card: left = raw design file · right = GPT composite mockup (or FW photo)</p>
<div class="legend">
  <span><div class="dot composite"></div> Composite / FW mockup ready</span>
  <span><div class="dot raw"></div> Raw design only — needs mockup</span>
  <span><div class="dot missing"></div> Corrupted / missing file</span>
</div>

<!-- ═══════════════════════════════════════════════════════════ SL SHIRTS -->
<div class="section-label">Southern Legends — Active + Booth Designs</div>
<div class="grid">

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Transparent</span>
        <img src="../public/merch/survived-woodstock-trans.png" alt="Woodstock transparent">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/woodstock-shirt-mockup.webp" alt="Woodstock mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">I Survived Woodstock Avenue</div>
      <div class="card-id">woodstock-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/survived-woodstock-trans.png</div>
        <div class="card-path has-mockup">mockup: /merch/woodstock-shirt-mockup.webp (navy)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Raw</span>
        <img src="../public/merch/pv-raiders-xc.webp" alt="PV Raiders raw">
      </div>
      <div class="img-panel">
        <span class="panel-label raw-label">FW photo</span>
        <img src="../public/merch/pv-shirt-mockup.webp" alt="PV Raiders mockup" onerror="this.parentElement.innerHTML='<div class=placeholder><svg width=32 height=32 fill=none stroke=currentColor stroke-width=1.5 viewBox=&quot;0 0 24 24&quot;><rect x=3 y=3 width=18 height=18 rx=2/></svg>No mockup</div>'">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">PV Raiders XC</div>
      <div class="card-id">pv-raiders-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/pv-raiders-xc.webp</div>
        <div class="card-path has-mockup">mockup: /merch/pv-shirt-mockup.webp</div>
      </div>
      <span class="badge raw">Raw + photo</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Raw</span>
        <img src="../public/merch/clt-shirt-print.png" alt="CLT raw">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/clt-shirt-mockup.webp" alt="CLT mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">Ladiga's Land — Chief Ladiga Trail</div>
      <div class="card-id">clt-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/clt-shirt-print.png</div>
        <div class="card-path has-mockup">mockup: /merch/clt-shirt-mockup.webp (olive)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Raw</span>
        <img src="../public/merch/freedom-riders/freedom-riders-bus-design.png" alt="Freedom Riders raw">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/freedom-riders/shirt-mockup-dark.webp" alt="Freedom Riders mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">Freedom Riders — Anniston, 1961</div>
      <div class="card-id">freedom-riders-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/freedom-riders/freedom-riders-bus-design.png</div>
        <div class="card-path has-mockup">mockup: /merch/freedom-riders/shirt-mockup-dark.webp (black)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Raw</span>
        <img src="../public/merch/model-city-print.png" alt="Model City raw">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/model-city-mockup-cream.webp" alt="Model City mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">The Model City — Anniston</div>
      <div class="card-id">model-city-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/model-city-print.png</div>
        <div class="card-path has-mockup">mockup: /merch/model-city-mockup-cream.webp (cream)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Raw</span>
        <img src="../public/merch/coldwater-shirt.png" alt="Coldwater raw">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/coldwater-shirt-mockup.webp" alt="Coldwater mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">Coldwater Mountain</div>
      <div class="card-id">coldwater-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/coldwater-shirt.png (star artifact in margin)</div>
        <div class="card-path has-mockup">mockup: /merch/coldwater-shirt-mockup.webp (forest — margins cropped)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Raw</span>
        <img src="../public/merch/fort-mcclellan-shirt.png" alt="Fort McClellan raw">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/fort-mcclellan-shirt-mockup.webp" alt="Fort McClellan mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">Fort McClellan</div>
      <div class="card-id">fort-mcclellan-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/fort-mcclellan-shirt.png (star artifact in margin)</div>
        <div class="card-path has-mockup">mockup: /merch/fort-mcclellan-shirt-mockup.webp (olive — margins cropped)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Transparent</span>
        <img src="../public/merch/cheaha-tower-badge-trans.png" alt="Cheaha Tower transparent">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/cheaha-tower-mockup.webp" alt="Cheaha Tower mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">Cheaha Tower — 2,413 ft</div>
      <div class="card-id">cheaha-tower-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/cheaha-tower-badge-trans.png</div>
        <div class="card-path has-mockup">mockup: /merch/cheaha-tower-mockup.webp (forest)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Transparent</span>
        <img src="../public/merch/jacksonville-gamecock-trans.png" alt="Jacksonville Gamecock transparent">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
        <img src="../public/merch/jacksonville-gamecock-mockup.webp" alt="Jacksonville Gamecock mockup">
      </div>
    </div>
    <div class="card-body">
      <div class="card-name">Jacksonville — Home of JSU</div>
      <div class="card-id">jacksonville-gamecock-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/jacksonville-gamecock-trans.png</div>
        <div class="card-path has-mockup">mockup: /merch/jacksonville-gamecock-mockup.webp (navy)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Transparent</span>
        <img src="../public/merch/clt-hike-explore-trans.png" alt="Hike Explore transparent">
