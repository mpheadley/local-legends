  <div class="card">
    <div class="img-row">
      <div class="img-panel">
        <span class="panel-label raw-label">Transparent</span>
        <img src="../public/merch/piedmont-trans.png" alt="Piedmont transparent">
      </div>
      <div class="img-panel">
        <span class="panel-label composite-label">Composite</span>
