      <div class="img-panel">
        <span class="panel-label missing-label">Print only</span>
        <div class="placeholder">
          <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          Print / sticker
