    </div>
    <div class="card-body">
      <div class="card-name">Hike & Explore — CLT</div>
      <div class="card-id">clt-hike-explore-shirt</div>
      <div class="card-paths">
        <div class="card-path needs-mockup">raw: /merch/clt-hike-explore-trans.png</div>
        <div class="card-path has-mockup">mockup: /merch/clt-hike-explore-mockup.webp (olive)</div>
      </div>
      <span class="badge composite">GPT composite</span>
    </div>
  </div>

  <div class="card">
    <div class="img-row">
